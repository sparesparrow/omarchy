#!/bin/bash

# omarchy:summary=Let dictation understand any spoken language for Studio
# omarchy:hidden=true

# Studio is for people who may not speak English, so the English-only model
# Voxtype ships with has to go. Other backends (Superwhisper) detect the spoken
# language themselves.
[[ $(omarchy-default-dictation 2>/dev/null) == "voxtype" ]] || exit 0

config="${XDG_CONFIG_HOME:-$HOME/.config}/voxtype/config.toml"
[[ -f $config ]] || exit 0

# Already multilingual: nothing to change or download.
if grep -qE '^model = "[a-z0-9-]+"' "$config" && ! grep -qE '^model = ".*\.en"' "$config" &&
  grep -qx 'language = "auto"' "$config"; then
  exit 0
fi

sed -i -E 's/^model = "([a-z0-9-]+)\.en"/model = "\1"/; s/^language = ".*"/language = "auto"/' "$config"

# Download the multilingual model, then pick up the new config.
voxtype setup --download --no-post-install
systemctl --user restart voxtype.service
